# Mẫu biến môi trường (KT-11). Chỉ tên biến + placeholder — KHÔNG ghi giá trị thật.
# Không đặt gì: nội dung từ seed, noindex, chỉ tiếng Việt, nội dung preview, form demo.

# --- Host / index (SEO-01, SEO-02) ---
# Origin chuẩn = host cuối trả 200, không / cuối. Bắt buộc trên mọi bản deploy.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
# "1" mới cho index (và chỉ khi production + host không phải *.vercel.app). Mặc định: noindex.
ALLOW_INDEXING=0

# --- Nội dung (KT-01) ---
# seed | sanity. Bỏ trống: có NEXT_PUBLIC_SANITY_PROJECT_ID → sanity, không có → seed.
SANITY_SOURCE=seed
# preview (hiện nhãn «chờ xác nhận») | release (ẩn nội dung chưa xác nhận)
CONTENT_MODE=preview
# Ngôn ngữ đang bật, phân cách dấu phẩy: vi | vi,en
SITE_LANGUAGES=vi
# Tệp seed tương đối trong seed/ (bỏ trống = sanity/documents.json)
SEED_FILE=

# --- Sanity (chỉ bắt buộc khi SANITY_SOURCE=sanity) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Lead (dự án không có form lead; giữ tên biến theo chuẩn) ---
LEAD_DESTINATION=digiagent_crm
DGA_API_URL=
DGA_FORM_KEY=
LEAD_TO_EMAIL=
# "0" mới gửi thật; mặc định chế độ demo
LEADS_DRY_RUN=1

# --- Tracking / widget (trống → không nhúng script) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CHAT_WIDGET_KEY=

# --- Cron ---
CRON_SECRET=
